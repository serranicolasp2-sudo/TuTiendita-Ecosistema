# /etc/tutiendita-ia/env  (permisos 600, dueño tutiendita). Valores de EJEMPLO: completar.
DJANGO_SETTINGS_MODULE=config.settings.prod
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=GENERAR
ALLOWED_HOSTS=tutiendita-ia.store,www.tutiendita-ia.store
CSRF_TRUSTED_ORIGINS=https://tutiendita-ia.store,https://www.tutiendita-ia.store
SITE_URL=https://tutiendita-ia.store
# Etapa 1 casi no usa la base; el foro y el campus pasan a PostgreSQL (docs/HOJA-DE-RUTA.md).
DATABASE_URL=sqlite:////var/lib/tutiendita-ia/db.sqlite3
# HSTS: una semana para empezar; subir a 31536000 (un año) cuando el dominio esté estable.
SECURE_HSTS_SECONDS=604800
GUNICORN_WORKERS=2
LOG_NIVEL=INFO

# Contacto. WhatsApp y mail: vacíos no se muestran. Instagram y GitHub: vacíos usan los de config/settings/base.py.
CONTACTO_WHATSAPP=
CONTACTO_INSTAGRAM=
CONTACTO_EMAIL=
CONTACTO_GITHUB=https://github.com/serranicolasp2-sudo
